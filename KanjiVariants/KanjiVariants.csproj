<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <PackageId>KanjiVariants</PackageId>
    <Authors>Koichi Kobayashi</Authors>
    <Description>MJ縮退マップに基づく漢字代替候補の検索・置換と、文化庁の常用漢字表の音訓索引を参照できる .NET ライブラリです。JIS X 0208、JIS X 0213、および登録済みIVS/SVSに対応しています。</Description>
    <PackageTitle>KanjiVariants</PackageTitle>
    <PackageTags>kanji;japanese;unicode;jis;jisx0208;jisx0213;ivs;svs;mj;joyo;onkun;dotnet</PackageTags>
    <PackageReleaseNotes>初回リリース。</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE-NOTICES.md</PackageLicenseFile>
    <Copyright>Copyright (c) 2026 Koichi Kobayashi</Copyright>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KanjiVariants.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE-NOTICES.md" Pack="true" PackagePath="\" />
    <None Include="..\data\MJUniqueAlternatives.1.2.0.csv" Pack="true" PackagePath="data\" />
  </ItemGroup>

</Project>
