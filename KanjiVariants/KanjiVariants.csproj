<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <PackageId>KanjiVariants</PackageId>
    <Authors>Koichi Kobayashi</Authors>
    <Description>A .NET library for Japanese kanji variants and fallback, character metadata, JIS X 0208/0212/0213, Joyo and Jinmeiyo kanji, educational kanji, readings, okurigana, and MJ character information.</Description>
    <RepositoryUrl>https://github.com/Koichi-Kobayashi/KanjiVariants</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://koichi-kobayashi.github.io/KanjiVariants/</PackageProjectUrl>
    <PackageTitle>KanjiVariants</PackageTitle>
    <PackageTags>kanji;japanese;unicode;jis;jisx0208;jisx0212;jisx0213;ivs;svs;mj;joyo;jinmeiyo;okurigana;onkun;education;grade;dotnet</PackageTags>
    <PackageReleaseNotes>
      - JIS X 0208の生成元をSHA-256固定のUnicode JIS0208.TXT Table 2.0へ変更
      - 1区32点の互換処理を維持し、JIS所属判定と既存の生成データを変更せず再現性を改善
      - Unicode原典・許諾全文を同梱し、MJ加工データのCC BY-SA 2.1 JP適用範囲を明確化
      - SDKのPathMap・SourceLink正規化で開発PC固有のPDB絶対パスを除去
      - net6.0と既存1.2.0の公開API・動作の互換性を維持
    </PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE-NOTICES.md</PackageLicenseFile>
    <Copyright>Copyright (c) 2026 Koichi Kobayashi</Copyright>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KanjiVariants.Benchmarks" />
    <InternalsVisibleTo Include="KanjiVariants.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE-NOTICES.md" Pack="true" PackagePath="\" />
    <None Include="../data/JIS/JIS0208.TXT" Pack="true" PackagePath="data/JIS/" />
    <None Include="../data/JIS/Unicode-LICENSE.txt" Pack="true" PackagePath="data/JIS/" />
  </ItemGroup>

</Project>
