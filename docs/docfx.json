{
  "metadata": [
    {
      "src": [
        {
          "src": "../",
          "files": [
            "KanjiVariants/KanjiVariants.csproj"
          ]
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net6.0",
        "Configuration": "Release"
      },
      "disableGitFeatures": true
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "toc.yml",
          "articles/**.md",
          "articles/toc.yml",
          "api/**.yml",
          "api/index.md"
        ]
      }
    ],
    "dest": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appTitle": "KanjiVariants",
      "_appName": "KanjiVariants",
      "_appFooter": "KanjiVariants API documentation",
      "_disableContribution": true,
      "_lang": "ja"
    }
  }
}
